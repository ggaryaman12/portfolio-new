{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/works", "destination": "/work", "permanent": true },
    { "source": "/side-quests", "destination": "/work", "permanent": true },
    { "source": "/jugnoo-project", "destination": "/case-jugnoo", "permanent": true },
    { "source": "/plant-parents-2", "destination": "/case-plantparents", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
